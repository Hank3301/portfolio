<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="ogbg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#05070c"/>
      <stop offset="100%" stop-color="#0b0f18"/>
    </linearGradient>
    <linearGradient id="ogaccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00ff88"/>
      <stop offset="100%" stop-color="#00cc6a"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#ogbg)"/>
  <rect x="60" y="60" width="1080" height="510" fill="none" stroke="url(#ogaccent)" stroke-width="2" stroke-opacity="0.3" rx="16"/>
  <text x="600" y="250" font-family="Michroma, sans-serif" font-size="72" fill="#00ff88" text-anchor="middle" letter-spacing="0.16em">BACKEND ENGINEER</text>
  <text x="600" y="330" font-family="Michroma, sans-serif" font-size="36" fill="#c9ccd3" text-anchor="middle" letter-spacing="0.1em">Automation • Bots • AI Agents</text>
  <text x="600" y="420" font-family="IBM Plex Mono, monospace" font-size="18" fill="#8b909b" text-anchor="middle">Building scalable systems that think.</text>
  <text x="600" y="520" font-family="IBM Plex Mono, monospace" font-size="14" fill="#00ff88" text-anchor="middle">@seunome • github.com/seunome</text>
</svg>
