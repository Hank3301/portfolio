# App
APP_NAME=Portfolio API
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portfolio_db
# ou para Supabase (pooler):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxx.supabase.co:6543/postgres

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# GitHub Integration
GITHUB_USERNAME=seu-usuario-github
# Opcional: token com escopo 'public_repo' (5000 req/hora em vez de 60 sem token)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
